{
  "name": "sol-check",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "voice:setup": "python3 -m venv voice-server/.venv && voice-server/.venv/bin/pip install -r voice-server/requirements.txt",
    "voice:server": "voice-server/.venv/bin/python voice-server/server.py",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "SOLCHECK_HTTPS_PORT=4174 vite preview",
    "mobile": "node scripts/mobile-qr.mjs",
    "test": "vitest run",
    "build:native": "SOLCHECK_TARGET=native npm run build && node scripts/native-postbuild.mjs",
    "cap:sync": "npm run build:native && npx cap sync",
    "ios": "npm run cap:sync && npx cap open ios",
    "android": "npm run cap:sync && npx cap open android",
    "icons": "node scripts/generate-app-icons.mjs && capacitor-assets generate --ios --android --iconBackgroundColor '#070B14' --iconBackgroundColorDark '#070B14' --splashBackgroundColor '#070B14' --splashBackgroundColorDark '#070B14'",
    "preview:phone": "SOLCHECK_HTTPS=1 vite preview --host 0.0.0.0 --port 4174 --strictPort",
    "serve:phones": "npm run build && (SOLCHECK_HTTPS=1 vite preview --host 0.0.0.0 --port 4174 --strictPort & SOLCHECK_HTTPS_PORT=4174 vite preview --host 0.0.0.0 --port 4173 --strictPort & sleep 3 && node scripts/phone-qr.mjs)",
    "phone": "node scripts/phone-qr.mjs",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug && cd .. && npm run build",
    "android:qr": "node scripts/android-qr.mjs",
    "ios:device": "node scripts/ios-install.mjs",
    "expo:go": "node scripts/expo-go.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@huggingface/transformers": "3.7.6",
    "@litertjs/core": "^0.2.1",
    "@mediapipe/tasks-vision": "^0.10.21",
    "lucide-react": "^1.72.0",
    "phonemizer": "1.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "three": "^0.181.0",
    "vitalcamera-sdk": "^0.6.9",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.6"
    }
  }
}
